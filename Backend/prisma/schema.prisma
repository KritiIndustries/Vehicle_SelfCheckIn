datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Guard_Master {
  Guard_Id     Int      @id @default(autoincrement())
  Name         String
  Mobile       String   @unique
  Active       Boolean  @default(true)
  OTP          String?
  OTP_Expiry   DateTime?

  Created_At   DateTime @default(now())
  Updated_At   DateTime @updatedAt

  Verified_Documents Driver_Documents[]
  RejectedVehicles   Rejected_Vehicle[]
  Reviewed_Edits     Edited_Documents[]

  @@map("GUARD_MASTER")
}

model Security_Logs {
  id        Int      @id @default(autoincrement())
  userId    Int?
  ip        String?
  latitude  Float?
  longitude Float?
  distance  Float?
  reason    String?
  createdAt DateTime @default(now())
}

model Driver_Checkin {
  Id                     Int      @id @default(autoincrement())

  Do_No                  String
  Vehicle_No             String
  Driver_Name            String
  Mobile                 String
  License_Number         String?

  Licence_Expiry_Date    DateTime?
  Insurance_Number       String?
  Insurance_Expiry_Date  DateTime?
  Chassis_Number         String?
  Rc_Expiry_Date         DateTime?
  Fitness_Expiry_Date    DateTime?

  Status                 String   @default("Pending")

  Zgp                    String?  @unique
  Token                  Int?
  ReportIn_Time          DateTime?
  Entry_Time             DateTime?
  Exit_Time              DateTime?

  Latitude               Decimal?
  Longitude              Decimal?

  Created_At             DateTime @default(now())
  Updated_At             DateTime @updatedAt

  Documents              Driver_Documents[]
  weighbridge            Weighbridge?
  RejectedVehicle        Rejected_Vehicle[] 
  EditedDocuments       Edited_Documents[]

  @@map("DRIVER_CHECKIN")

  @@index([Do_No])
  @@index([Vehicle_No])
  @@index([Status])
}

model Driver_Documents {
  Id                   Int      @id @default(autoincrement())

  Driver_Checkin_Id    Int
  Doc_Type             String
  Expiry_Date          DateTime?
  Verified             Boolean   @default(false)
  Image_Path           String

  Verified_By          Int?

  Driver_Checkin       Driver_Checkin @relation(fields: [Driver_Checkin_Id], references: [Id])
  Guard                Guard_Master?  @relation(fields: [Verified_By], references: [Guard_Id])

  Created_At           DateTime @default(now())
  Updated_At           DateTime @updatedAt
  EditedEntries        Edited_Documents[]

  @@map("DRIVER_DOCUMENTS")
  @@index([Driver_Checkin_Id])
  @@index([Verified_By])
}

model Edited_Documents {
  Id                 Int       @id @default(autoincrement())

  Driver_Checkin_Id  Int?
  Driver_Document_Id Int?

  Doc_Type           String
  Edited_Fields      Json
  Image_Path         String?

  Reviewed           Boolean   @default(false)
  Reviewed_By        Int?

  Created_At         DateTime  @default(now())
  Updated_At         DateTime  @updatedAt

  Driver_Checkin     Driver_Checkin?   @relation(fields: [Driver_Checkin_Id], references: [Id])
  Driver_Document    Driver_Documents? @relation(fields: [Driver_Document_Id], references: [Id])
  Guard              Guard_Master?     @relation(fields: [Reviewed_By], references: [Guard_Id])

  @@map("EDITED_DOCUMENTS")
  @@index([Driver_Checkin_Id])
  @@index([Driver_Document_Id])
  @@index([Reviewed_By])
}

model Driver_Temp_Upload {
  Id          Int      @id @default(autoincrement())
  Session_Id  String
  Doc_Type    String
  Image_Path  String
  Is_Selfie   Boolean  @default(false)

  Created_At  DateTime @default(now())

  @@index([Session_Id])
}

model Weighbridge {
  Id            Int      @id @default(autoincrement())

  TicketNo      String?   @unique
  VehicleNo     String
  TagNo         String?

  Transporter   String?

  GatePassNo    String   @unique

  driverCheckin Driver_Checkin @relation(fields: [GatePassNo], references: [Zgp])

  Tolerances    Decimal?@db.Decimal(10,2)


  GrossWeight   Decimal?@db.Decimal(10,2)

  GrossDate     DateTime?
  GrossTime     String?

  TareWeight    Decimal?@db.Decimal(10,2)

  TareDate      DateTime?
  TareTime      String?

  NetWeight     Decimal?@db.Decimal(10,2)


  Duration      Int?
  Shift         String?

  Created_At    DateTime @default(now())
  Updated_At    DateTime @updatedAt

  @@map("WEIGHBRIDGE")

  @@index([VehicleNo])
  @@index([GatePassNo])
}

model Rejected_Vehicle {
  Id              Int      @id @default(autoincrement())

  Driver_Checkin_Id Int
  Rejected_By     Int      // Guard_Id

  Reason          String   // rejection reason

  Rejected_At     DateTime @default(now())
  Created_At      DateTime @default(now())
  Updated_At      DateTime @updatedAt

  // ✅ Relations
  DriverCheckin   Driver_Checkin @relation(fields: [Driver_Checkin_Id], references: [Id])
  Guard           Guard_Master   @relation(fields: [Rejected_By], references: [Guard_Id])

  @@map("REJECTED_VEHICLE")
  @@index([Driver_Checkin_Id])
  @@index([Rejected_By])
}